# Ports
FONTEND_PORT=8080
EMBEDDING_PORT=8000
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
GRAFANA_PORT=3000

# APP
ARXIV_SOURCE_FORMAT=html

# OpenRouter provider slugs in priority order (empty = automatic routing).
OPENROUTER_PROVIDER_ORDER=streamlake,sail-research,together
OPENROUTER_API_KEY=
RAG_OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
RAG_OPENROUTER_REASONING_EFFORT=
SUMMARY_OPENROUTER_MODEL=deepseek/deepseek-v4-pro-0813
SUMMARY_OPENROUTER_REASONING_EFFORT=high


# Embeddings
EMBEDDING_OPENROUTER_MODEL=baai/bge-m3
EMBEDDING_TIMEOUT=60
CHUNK_OVERLAP_PERCENT=0
EMBEDDING_MAX_TOKENS=512
QDRANT_URL=http://qdrant:6333


# PostgreSQL and pgAdmin
POSTGRES_DB=deepsemantic
POSTGRES_USER=deepsemantic
POSTGRES_PASSWORD=deepsemantic
PGADMIN_DEFAULT_EMAIL=admin@deepsemantic.dev
PGADMIN_DEFAULT_PASSWORD=deepsemantic

# RustFS
RUSTFS_ACCESS_KEY=deepsemantic
RUSTFS_SECRET_KEY=deepsemantic-local
RUSTFS_BUCKET=arxiv-papers

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=deepsemantic
