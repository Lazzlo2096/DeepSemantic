{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "ad792cc"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "import-history": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "История заданий импорта",
          "description": "События постановки заданий в очередь за выбранный период.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "deepsemantic-loki"
                      },
                      "spec": {
                        "direction": "backward",
                        "editorMode": "code",
                        "expr": "{service_name=~\"arxiv-grabber|api\"}\n| json\n| event=\"arxiv_import.insert\"\n| import_id != \"\"",
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "13.3.0",
            "spec": {
              "options": {
                "allowDownload": true,
                "dedupStrategy": "none",
                "detailsMode": "sidebar",
                "displayedFields": [
                  "event",
                  "import_id"
                ],
                "enableInfiniteScrolling": false,
                "enableLogDetails": false,
                "fontSize": "small",
                "prettifyLogMessage": false,
                "showControls": true,
                "showFieldSelector": true,
                "showLabels": false,
                "showLevel": false,
                "showLogAttributes": false,
                "showTime": true,
                "sortOrder": "Descending",
                "syntaxHighlighting": true,
                "timestampResolution": "ms",
                "unwrappedColumns": false,
                "wrapLogMessage": false
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "latest-import-logs": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Логи последнего импорта",
          "description": "События с ID последнего задания, созданного за выбранный период.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "deepsemantic-loki"
                      },
                      "spec": {
                        "direction": "backward",
                        "editorMode": "code",
                        "expr": "{service_name=~\"arxiv-grabber|arxiv-text-worker|api|embeding-service|paper-indexer\"}\n| json\n| import_id != \"\"\n| import_id=\"${latest_import_id:raw}\"",
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "13.3.0",
            "spec": {
              "options": {
                "allowDownload": false,
                "dedupStrategy": "none",
                "detailsMode": "inline",
                "displayedFields": [
                  "service_name",
                  "___LOG_LINE_BODY___"
                ],
                "enableInfiniteScrolling": false,
                "enableLogDetails": false,
                "prettifyLogMessage": true,
                "showControls": true,
                "showFieldSelector": true,
                "showLabels": false,
                "showLevel": true,
                "showLogAttributes": true,
                "showTime": true,
                "sortOrder": "Descending",
                "syntaxHighlighting": true,
                "timestampResolution": "ms",
                "unwrappedColumns": false,
                "wrapLogMessage": false
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "AutoGridLayout",
      "spec": {
        "maxColumnCount": 3,
        "columnWidthMode": "standard",
        "rowHeightMode": "standard",
        "items": [
          {
            "kind": "AutoGridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "import-history"
              }
            }
          },
          {
            "kind": "AutoGridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "latest-import-logs"
              }
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": [
      "arxiv",
      "imports"
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "Импорт статей arXiv",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "latest_import_id",
          "current": {
            "text": "Нет импортов",
            "value": "none"
          },
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": true,
          "query": {
            "kind": "DataQuery",
            "group": "yesoreyeram-infinity-datasource",
            "version": "v0",
            "datasource": {
              "name": "deepsemantic-loki-http"
            },
            "spec": {
              "queryType": "infinity",
              "refId": "latest-import-id",
              "meta": {
                "textField": "label",
                "valueField": "import_id"
              },
              "infinityQuery": {
                "type": "json",
                "parser": "jq-backend",
                "source": "url",
                "format": "table",
                "refId": "latest-import-id",
                "url": "http://loki:3100/loki/api/v1/query_range",
                "url_options": {
                  "method": "GET",
                  "params": [
                    {
                      "key": "query",
                      "value": "{service_name=~\"arxiv-grabber|api\"} | json event=\"event\", import_id=\"import_id\" | event=\"arxiv_import.insert\" | import_id != \"\" | line_format \"{{.import_id}}\""
                    },
                    {
                      "key": "direction",
                      "value": "backward"
                    },
                    {
                      "key": "limit",
                      "value": "1"
                    },
                    {
                      "key": "start",
                      "value": "${__timeFrom:date:iso}"
                    },
                    {
                      "key": "end",
                      "value": "${__timeTo:date:iso}"
                    }
                  ]
                },
                "root_selector": "[.data.result[].values[] | {import_id: .[1], label: .[1]}] | if length == 0 then [{import_id: \"none\", label: \"Нет импортов\"}] else . end",
                "columns": [
                  {
                    "selector": "import_id",
                    "text": "import_id",
                    "type": "string"
                  },
                  {
                    "selector": "label",
                    "text": "label",
                    "type": "string"
                  }
                ]
              }
            }
          },
          "regex": "",
          "regexApplyTo": "value",
          "sort": "disabled",
          "definition": "",
          "options": [],
          "multi": false,
          "includeAll": false,
          "allowCustomValue": false,
          "label": "ID последнего импорта",
          "description": "ID из самого свежего события постановки импорта в очередь за выбранный период."
        }
      }
    ],
    "preferences": {
      "layout": {
        "kind": "AutoGridLayout",
        "spec": {
          "maxColumnCount": 3,
          "columnWidthMode": "standard",
          "rowHeightMode": "standard",
          "items": []
        }
      }
    },
    "description": "История постановки заданий импорта и логи последнего задания за выбранный период."
  }
}
